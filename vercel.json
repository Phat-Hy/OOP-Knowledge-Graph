{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/style.css",
      "destination": "/oop-kg/frontend/style.css"
    },
    {
      "source": "/app.js",
      "destination": "/oop-kg/frontend/app.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/oop-kg/frontend/index.html"
    }
  ]
}
